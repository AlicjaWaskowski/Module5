A <- matrix(1:100, nrow=10)

B <- matrix(1:1000, nrow=10)

print("Matrix A:")
print(A)

print("Matrix B:")
print(B)

print("Determinant of Matrix A:")
det_A <- det(A)
print(det_A)

if (det_A != 0) {
  print("Inverse of Matrix A:")
  inv_A <- solve(A)
  print(inv_A)
} else {
  print("Matrix A is singular and does not have an inverse.")
}

print("Determinant of Matrix B:")
print("Matrix B is not square, so determinant cannot be calculated.")

print("Inverse of Matrix B:")
print("Matrix B is not square, so its inverse cannot be calculated.")

